# Without this, `COPY app/ app/` etc. in docker/*/Dockerfile send local Gradle/npm build
# output into the build context — slow, and can produce duplicate-class errors when a stale
# build directory is copied in alongside the sources.
#
# Deliberately NOT **/build/ — that also matches the legitimate source package directory
# buildSrc/src/main/java/dev/monkeypatch/build/, excluding it from the build context entirely
# and breaking buildSrc compilation (NO-SOURCE) for every image that configures :app.
.git/
/build/
app/build/
decoder-simulator/build/
decoder-protocol/build/
localday/build/
buildSrc/build/
**/.gradle/
**/node_modules/
frontend/dist/
frontend-local/dist/
localday/data/
app/data/
