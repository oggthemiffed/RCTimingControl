#!/bin/sh
# preinst for rctimingcontrol (#23): when upgrading, make sure the old version's service is
# stopped before its files are replaced.
set -e

UNIT=rctimingcontrol-RCTimingControl.service

case "$1" in
    install|upgrade)
        if [ -n "$2" ] && [ -d /run/systemd/system ]; then
            systemctl stop "$UNIT" || true
        fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
