[Unit]
Description=RC Timing Control (race timing and race control)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=APPLICATION_LAUNCHER
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
# The app is reachable from every device on the venue network, so it runs as its own unprivileged
# user, not root. postinst creates the rctiming system user; a folder for backups on a USB stick
# or share only has to be writable by that user. StateDirectory gives it /var/lib/rctimingcontrol
# (data, logs, optional settings).
User=rctiming
Group=rctiming
StateDirectory=rctimingcontrol
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
