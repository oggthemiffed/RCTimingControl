#!/bin/sh
# postinst for rctimingcontrol (#23). Replaces jpackage's own, which enables the unit by its
# /lib path. On merged-/usr systems systemd then treats it as a linked unit and refuses to
# disable it later, so upgrades and removal fail. Here the unit is always used by name.
set -e

UNIT=rctimingcontrol-RCTimingControl.service

case "$1" in
    configure)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable "$UNIT"
            systemctl restart "$UNIT"
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
