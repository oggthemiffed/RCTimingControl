# Gradle build outputs
.gradle/
build/
**/build/

# jOOQ generated sources are committed at app/src/generated/jooq, so builds can skip codegen

# IDE files
.idea/
*.iml
.vscode/

# OS files
.DS_Store
Thumbs.db

# Spring Boot
*.jar
*.war
!gradle/wrapper/gradle-wrapper.jar

# Environment
.env
.env.local

# Dev data: the SQLite database (app/data/db), club logos and TTS clips
app/data/

# SQLite databases and their WAL and shared-memory files, wherever a run puts them
*.db
*.db-wal
*.db-shm

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
bin/

# Playwright
frontend/playwright-report/
frontend/test-results/

# Local-only ops notes (never commit)
docs/local-*.md
*.local.md

# Compound Engineering per-machine config
.compound-engineering/*.local.yaml
